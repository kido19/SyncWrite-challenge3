# Copy this file to .env and fill in your real values. Never commit .env to git.

# Your MongoDB Atlas connection string (from Step 3)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/syncwrite

# A long random string used to sign JWT tokens. Any random text works, e.g.
# generate one at https://randomkeygen.com or just mash your keyboard.
JWT_SECRET=replace_this_with_a_long_random_string

# Port your backend server runs on
PORT=5000

# The URL your React frontend will run on (for CORS)
CLIENT_URL=http://localhost:5173
